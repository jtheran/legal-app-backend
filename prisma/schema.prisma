
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

enum Role {
  ADMIN
  LAWYER
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum CourtType {
  CIVIL
  PENAL
  LABORAL
  FAMILIA
  ADMINISTRATIVO
  COMERCIAL
  CONSTITUCIONAL
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  dni       String   @unique
  name      String
  active    Boolean         @default(true)
  role      Role     @default(LAWYER)
  clients   Client[]
  cases     Case[]
  events    CalendarEvent[]
  notifications Notification[]
  documents Document[]
  createdAt DateTime @default(now())
}

model Client {
  id        String   @id @default(uuid())
  name      String
  type     String    @default("NATURAL")
  companyName    String?
  address   String
  dni       String   @unique
  phone     String
  email     String  @unique
  city      String    @default("Cartagena")
  state     String    @default("Bolivar")       
  country   String    @default("Colombia")
  cases     Case[]
  lawyer    User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Court {
  id             String    @id @default(uuid())
  name           String                         
  type           CourtType         // CIVIL | PENAL | LABORAL | FAMILIA | ADMINISTRATIVO | COMERCIAL | CONSTITUCIONAL
  judgeName      String?                        
  judgePhone     String?
  judgeEmail     String?
  city           String
  state          String                        
  country        String    @default("Colombia")
  address        String?                
  email          String?
  isActive       Boolean   @default(true)
  notes          Json?
  cases          Case[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([type])
  @@index([city])
  @@map("courts")
}

model Case {
  id          String     @id @default(uuid())
  folderNumber String    @unique // Número de expediente
  title       String
  description String?
  courtId     String?
  court       Court?     @relation(fields: [courtId], references: [id])
  status      CaseStatus @default(OPEN)
  documents   Document[]
  lawyer      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId      String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime   @updatedAt
}

model Document {
  id        String   @id @default(uuid())
  name      String
  url       String   // URL de S3
  type      String   // pdf, docx, etc.
  size      Int      // Tamaño en bytes
  vectorId  String?  // Referencia en Qdrant para el RAG
  case      Case     @relation(fields: [caseId], references: [id])
  caseId    String
  lawyer    User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CalendarEvent {
  id           String    @id @default(uuid())
  title        String
  description  String?
  startDate    DateTime
  endDate      DateTime
  allDay       Boolean   @default(false)
  location     String?
  color        String?   @default("#3B82F6")
  type         String    @default("EVENT")
  status       String    @default("ACTIVE")
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  reminders    EventReminder[]
  notifications EventNotification[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([startDate])
  @@map("calendar_events")
}

model EventReminder {
  id        String        @id @default(uuid())
  eventId   String
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  minutesBefore Int       // 120 = 2 horas antes, 1440 = 1 día antes
  sent      Boolean       @default(false)
  sentAt    DateTime?
  createdAt DateTime      @default(now())

  @@map("event_reminders")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String  
  resourceId String?
  read      Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

model EventNotification {
  id        String        @id @default(uuid())
  eventId   String
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      String        // TWO_HOURS | SAME_DAY
  sent      Boolean       @default(false)
  sentAt    DateTime?

  @@map("event_notifications")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userEmail   String?
  userRole    String?
  action      String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, VIEW, DOWNLOAD
  resource    String   // document, user, auth, system
  resourceId  String?
  description String?
  oldData     Json?
  newData     Json?
  ip          String?
  userAgent   String?
  status      String   @default("SUCCESS") // SUCCESS | FAILED
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("system_settings")
}